# URL pública do site, sem barra final. Alimenta metadataBase, canonical, Open Graph,
# sitemap, robots e JSON-LD (src/config/site.ts).
# Sem ela: na Vercel usa VERCEL_PROJECT_PRODUCTION_URL (injetada automaticamente);
# localmente, http://localhost:3000. Defina quando o domínio definitivo existir.
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# `?abertura=6` (congela a abertura) e `?stats` (estatísticas da maquete) em produção.
# Deixe vazio em produção real.
# NEXT_PUBLIC_INTRO_DEBUG=1
